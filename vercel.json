{
  "rewrites": [
    { "source": "/version", "destination": "/api/version" },
    { "source": "/version/", "destination": "/api/version" }
  ],
  "routes": [
    { "src": "^/wp-admin(/.*)?$", "status": 404 },
    { "src": "^/wp-login\\.php(/.*)?$", "status": 404 }
  ],
  "headers": [
    {
      "source": "/version",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/version/",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
